# The build context is what the Dockerfile COPYs: pyproject.toml, uv.lock, jobpilot/, frontend/, LICENSE and
# docs/third-party.md + docs/licenses/. Everything else stays out, so secrets and local state never reach a layer.
.git
.github
.vscode
.idea
.deepeval
.env
.env.*
.data
.venv
.venv-*
.pytest_cache
.ruff_cache
__pycache__
**/__pycache__
frontend/node_modules
# The dashboard is always built inside the image, never copied from a local build.
jobpilot/static
tests
scripts
Makefile
docs/*
!docs/third-party.md
!docs/licenses
*.log
.DS_Store
