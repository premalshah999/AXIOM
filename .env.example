# AXIOM configuration. Copy to .env (scripts/setup.sh does this for you) and never commit .env.
#
# How to read this file
#   NAME=          active and blank: you must (REQUIRED) or should (RECOMMENDED) fill it in.
#   # NAME=value   the built-in default. Uncomment and edit only to change it.
# Every variable the app reads (jobpilot/config.py, class Settings) is listed here; tests/test_env_example.py fails
# if one is missing. Values are plain text: no quotes, and no spaces around "=".
# Secrets (keys, tokens, passwords) are shown blank on purpose. Secrets can also be entered in the dashboard
# (Setup > Email for the mailbox) so they never touch a file.

# ==============================================================================================================
# Docker Compose (read by Compose, not by the app)
# ==============================================================================================================
# REQUIRED. Password for the bundled PostgreSQL. scripts/setup.sh generates one. Letters and digits only: it is
# placed inside a database URL. It is applied when the database volume is first created; changing it later does not
# change an existing volume.
POSTGRES_PASSWORD=
# Host port and address for the dashboard. 127.0.0.1 keeps it private to this computer; 0.0.0.0 exposes it to your
# network with no TLS, so only do that on a network you trust. If you change APP_PORT, BASE_URL follows it.
# APP_PORT=8080
# APP_BIND=127.0.0.1
# Compose project name. It prefixes the volumes (axiom_postgres, axiom_applicant-data). Keep it stable after the
# first start: a different name creates new, empty volumes and your data stays behind in the old ones.
# COMPOSE_PROJECT_NAME=axiom
# Source revision recorded in the image label. scripts/setup.sh sets it from git.
# GIT_SHA=unknown

# ==============================================================================================================
# Access, address and identity
# ==============================================================================================================
# The address you type in the browser: scheme, host and port. The API rejects browser writes whose Origin differs,
# so "localhost" and "127.0.0.1" are different here. Compose derives it from APP_PORT when this is not set.
# BASE_URL=http://127.0.0.1:8080
# true only behind an HTTPS reverse proxy with an https BASE_URL.
# SECURE_COOKIES=false
# Leave unset to generate a private token in the data volume. Print it with: docker compose exec app jobpilot token
# APP_TOKEN=
# IANA time zone for the daily application limit, the daily budget, schedules and the date written on forms.
# scripts/setup.sh writes your computer's zone here; without it the default is UTC.
# TIMEZONE=UTC

# ==============================================================================================================
# Language model. REQUIRED: the API key of the provider you choose. Answer and navigation providers can be set
# separately later in Setup > System; the others stay available as fallbacks.
# ==============================================================================================================
# deepseek | mimo | haiku | openai | openrouter
LLM_PROVIDER=deepseek

# OpenAI GPT-6 Luna (cheapest setting: reasoning effort "none"; a stronger retry tier uses "low", never more).
# Prices are USD per million tokens. The key can also be pasted in Setup > Connections (no restart needed).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-luna
# Always "disabled": OpenAI's effort is OPENAI_REASONING_EFFORT, not a thinking switch.
# OPENAI_THINKING=disabled
# OPENAI_REASONING_EFFORT=none
# OPENAI_INPUT_PRICE=0.10
# OPENAI_OUTPUT_PRICE=0.50
# OPENAI_CACHE_PRICE=0.01

# OpenRouter: DeepSeek V4.1 Flash 1017 served only by Relace, reasoning off (LLM_PROVIDER=openrouter).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_PROVIDER=relace
# OPENROUTER_ALLOW_FALLBACKS=false
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Always "disabled": the request sends reasoning {"enabled": false}.
# OPENROUTER_THINKING=disabled
# Relace's rates, USD per million tokens.
# OPENROUTER_INPUT_PRICE=0.07
# OPENROUTER_OUTPUT_PRICE=0.50
# OPENROUTER_CACHE_PRICE=0.008

# DeepSeek (OpenAI-compatible). Prices are USD per million tokens, peak and cache-miss rates.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# disabled | enabled. RECOMMENDED disabled: answers are short JSON, and thinking only adds latency and cost. The code
# default is enabled, so this stays active here.
DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=low
# DEEPSEEK_INPUT_PRICE=0.3
# DEEPSEEK_OUTPUT_PRICE=1.2
# DEEPSEEK_CACHE_PRICE=0.03

# Xiaomi MiMo (OpenAI-compatible)
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.6-pro
# MIMO_THINKING=disabled
# MIMO_INPUT_PRICE=0.435
# MIMO_OUTPUT_PRICE=0.87

# Anthropic Claude Haiku. ANTHROPIC_API_KEY is accepted as another name for HAIKU_API_KEY.
# HAIKU_API_KEY=
# HAIKU_BASE_URL=https://api.anthropic.com
# HAIKU_MODEL=claude-haiku-5-5
# HAIKU_THINKING=disabled
# HAIKU_INPUT_PRICE=0.1
# HAIKU_OUTPUT_PRICE=0.5

# TypeSafe Jev (optional). Answers multiple-choice questions before the main model does.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# JEV_INPUT_PRICE=0.042
# JEV_MIN_CONFIDENCE=0.8

# Image-reading model for browser recovery (optional; leave unset to reuse the main provider where it supports images).
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=
# VISION_INPUT_PRICE=0
# VISION_OUTPUT_PRICE=0

# Model limits and spend
# Spend ceiling per local day (USD). Requests stop for the day when it is reached.
# DAILY_BUDGET_USD=5
# Model calls one application may make before it stops.
# MAX_MODEL_CALLS=18
# Simultaneous model requests, and how many of them background work (quality checks, diagnostics) may use.
# MODEL_REQUEST_CONCURRENCY=7
# MODEL_BACKGROUND_CONCURRENCY=2
# Second-opinion check of saved answers.
# ANSWER_QUALITY_ENABLED=true

# ==============================================================================================================
# Browser
# ==============================================================================================================
# RECOMMENDED for real job sites. The worker Chrome runs on your computer, not in Docker (docs/SETUP.md):
#   BROWSER_CDP_URL=http://host.docker.internal:9224
# Blank uses the headless Chromium inside the container: enough for the demo and `jobpilot verify`, but many
# employer sites distrust a headless browser.
BROWSER_CDP_URL=
# Seconds between sweeps that close leftover application tabs on the worker Chrome. 0 turns the sweep off.
# TAB_CLEANUP_SECONDS=60
# Optional second, untouched Chrome that mints hCaptcha tokens for iCIMS-style sites (docs/SETUP.md, "Twin Chrome").
# Example: http://host.docker.internal:9225
# BROWSER_TWIN_CDP_URL=
# Host name suffixes whose hCaptcha goes to the twin Chrome first (comma separated).
# CAPTCHA_TWIN_HOSTS=icims.com,oraclecloud.com,lever.co,workable.com
# Headless Chromium when BROWSER_CDP_URL is blank.
# HEADLESS=true
# Skip images, fonts and media on employer pages (captcha providers are never blocked).
# BLOCK_ASSETS=true
# Keep a DOM snapshot, screenshot and decision per wizard step under DATA_DIR/runs/<id>/steps.
# TRACE_STEPS=true
# Native installs only: a custom Chromium or Chrome executable. Docker Compose always uses the image's own.
# CHROMIUM_PATH=
# Recovery from a stuck page: how many model-guided episodes and actions per episode, and whether screenshots may be used.
# BROWSER_RECOVERY_EPISODES=2
# BROWSER_RECOVERY_ACTIONS=6
# BROWSER_VISION_RECOVERY=true
# Keep a paused application's browser tab open instead of closing it.
# RETAIN_PAUSED_BROWSER=false

# ==============================================================================================================
# Email: one-time codes and verification links sent by employers. RECOMMENDED. Gmail needs 2-Step Verification and an
# app password (https://myaccount.google.com/apppasswords). You can instead enter them in Setup > Email, which
# encrypts the password and never shows it again. The mailbox must be the same address as your profile email.
# ==============================================================================================================
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
# Alternative to the app password: your own Google OAuth web client. The redirect is BASE_URL + /oauth/gmail/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Fernet key that encrypts stored mailbox and employer credentials. Unset creates DATA_DIR/mail-key: back that file up.
# MAIL_ENCRYPTION_KEY=
# How often to check for a pending code, how long an application waits for one inline, and how long a parked request lives.
# MAIL_POLL_SECONDS=3
# MAIL_WAIT_SECONDS=90
# MAIL_DURABLE_WAIT_SECONDS=1200

# ==============================================================================================================
# Employer accounts
# ==============================================================================================================
# One password is used for every employer account the app creates. Unset: one is generated once and stored encrypted.
# Set it before the first account is created. At least 10 characters with upper, lower, a digit and a symbol (some sites
# also cap it at 30). ACCOUNT_PASSWORD is accepted as another name.
# APPLICATION_PASSWORD=
# Email used to register employer accounts. Unset uses your profile email.
# ACCOUNT_EMAIL=
# Recover an account through its reset email when the saved password is rejected.
# ACCOUNT_PASSWORD_RESET=true
# A working iCIMS login password you already have. It applies only to iCIMS and is never logged or sent to a model.
# ICIMS_LOGIN=

# ==============================================================================================================
# CAPTCHA solving (optional; paid per solve)
# ==============================================================================================================
# 2Captcha API key. Without it, pages with a challenge wait for you.
# TWOCAPTCHA_API_KEY=
# CAPTCHA_TIMEOUT=300
# CAPTCHA_MAX_ATTEMPTS=2
# Answer hCaptcha image puzzles inside the worker's own browser so the token belongs to your IP address.
# CAPTCHA_SAME_IP=true
# CAPTCHA_IMAGE_ROUNDS=3

# ==============================================================================================================
# Telegram (optional): questions and alerts on your phone
# ==============================================================================================================
# Bot token from @BotFather, and your numeric Telegram user ID (not @username); only that user can control the bot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_USER_ID=
# TELEGRAM_ENABLED=true
# Seconds a worker keeps its page open waiting for your answer before parking the job.
# TELEGRAM_WAIT_SECONDS=0
# One distinct bot per worker slot (optional). With the default 6 + 2 workers, slots 1 to 6 are the ATS workers and
# 7 and 8 the specialists.
# TELEGRAM_WORKER_1_BOT_TOKEN=
# TELEGRAM_WORKER_2_BOT_TOKEN=
# TELEGRAM_WORKER_3_BOT_TOKEN=
# TELEGRAM_WORKER_4_BOT_TOKEN=
# TELEGRAM_WORKER_5_BOT_TOKEN=
# TELEGRAM_WORKER_6_BOT_TOKEN=
# TELEGRAM_WORKER_7_BOT_TOKEN=
# TELEGRAM_WORKER_8_BOT_TOKEN=

# ==============================================================================================================
# Workers, limits and pacing
# ==============================================================================================================
# ATS workers (browser owners). Each takes new applications and runs the flow of the platform it is given: a
# deterministic driver for Workday, Oracle, iCIMS, Taleo, SuccessFactors and Eightfold, the guided flow for Greenhouse,
# Lever, Ashby and the rest. Slots 1..N.
# NORMAL_WORKERS=6
# Specialist workers take difficult or already-failed applications with a somewhat larger budget. Slots N+1..N+S.
# 0 turns the specialists off: failed applications then retry on the ATS workers.
# SPECIALIST_WORKERS=2
# A job moves to a specialist after this many failures on ATS workers, but only after a failure an agent can fix
# (a stuck control or page, a timeout, a bad model reply). Missing facts, email waits, provider outages and
# uncertain submissions never move a job.
# SPECIALIST_AFTER_FAILURES=2
# Platforms where one such failure is enough (comma separated), and whether a stalled controller counts the same way.
# SPECIALIST_HARD_ATS=successfactors,eightfold,smartrecruiters,dayforce
# SPECIALIST_ON_STALL=true
# A specialist's wall-clock time, model calls and per-job token cap are this many times an ATS worker's, and it gets
# this many attempts per job.
# SPECIALIST_BUDGET_MULTIPLIER=1.5
# SPECIALIST_ATTEMPTS=2
# Deprecated: the old single number for all workers. While set it means the old layout (the first 6 are ATS workers,
# slots 7 and 8 specialists, so WORKERS=6 means no specialists) and cannot be combined with the settings above.
# WORKERS=
# Applications that may be submitted per local day.
# DAILY_APPLICATION_LIMIT=100
# Seconds one single-page application (Greenhouse, Lever, Ashby) and one multi-page application (Workday, Oracle,
# iCIMS, Taleo, SuccessFactors) may take.
# APPLICATION_TIMEOUT=180
# MULTIPAGE_TIMEOUT=480
# Seconds a stop (docker compose up/stop/restart) waits for applications that are committing before it exits. 0 stops
# at once. compose.yaml gives the container 180 s, so keep this at or below 150.
# SHUTDOWN_DRAIN_SECONDS=150
# Automatic retries of a failed draft and the minimum delay before the first one.
# RECOVERY_MAX_ATTEMPTS=2
# RECOVERY_DELAY_SECONDS=120
# adapters = a deterministic driver per ATS with the guided flow as fallback; guided = the guided flow everywhere.
# ENGINE=adapters
# Seconds between checks that refill idle workers with new applications.
# AUTOPILOT_REFILL_SECONDS=15
# Saved failure reports and the self-repair agent that proposes fixes for failed drafts.
# FAILURE_REPORTS_ENABLED=true
# REPAIR_AGENT_ENABLED=true

# ==============================================================================================================
# Job discovery
# ==============================================================================================================
# Simultaneous discovery workers (they use no browser).
# DISCOVERY_WORKERS=3
# Optional Google results provider (serper.dev). Public job feeds work without it.
# SERPER_API_KEY=
# SEARCH_QUERIES_PER_SWEEP=12

# ==============================================================================================================
# Runtime, storage and switches (Docker Compose sets the storage values for you)
# ==============================================================================================================
# Native installs only: where data lives. Compose uses /app/.data in a named volume.
# DATA_DIR=.data
# Blank means SQLite in DATA_DIR (development only). Compose sets both to PostgreSQL.
# DATABASE_URL=
# DBOS_DATABASE_URL=
# false serves only the dashboard and API: no queue, scheduler, mail polling or tab sweep.
# ENABLE_WORKERS=true
# The built-in demo employer form that `jobpilot verify` and the first-run tour use.
# ENABLE_DEMO=true
# Seconds a dashboard poll may be answered from the last snapshot while a fresh one builds.
# SNAPSHOT_CACHE_SECONDS=5
# Tests only. Allows localhost job URLs. Never set this on a real installation.
# ALLOW_PRIVATE_URLS=false
